<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!-- Exceptions assumees, chacune avec sa raison. -->
<suppressions>
    <!-- Le logger commun du mod est cree ici, une fois. -->
    <suppress checks="RegexpSingleline" files="ModConstants\.java" message="Un seul logger"/>
    <!-- Le benchmark ecrit ses chiffres sur la console : c'est son resultat, pas un journal. -->
    <suppress checks="RegexpSingleline" files="LevelZeroBenchmark\.java" message="Journal via"/>
</suppressions>
