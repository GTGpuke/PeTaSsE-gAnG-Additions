# ============================================================
#  .gitignore — PeTaSsE_gAnG_Additions (Fabric / Minecraft)
# ============================================================

# ── Gradle ───────────────────────────────────────────────────
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!gradle/wrapper/gradle-wrapper.properties

# ── IDE ──────────────────────────────────────────────────────
.idea/
*.iml
*.ipr
*.iws
.claude/
out/
.project
.classpath
.settings/
bin/
*.launch
.vscode/
!.vscode/launch.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/extensions.json
*.code-workspace

# ── Minecraft (runs de dev) ──────────────────────────────────
run/
logs/
*.log
crash-reports/
src/generated/

# ── Java ─────────────────────────────────────────────────────
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
hs_err_pid*
replay_pid*

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ── Divers ───────────────────────────────────────────────────
*.bak
*.tmp
*.swp
*.orig
.env
